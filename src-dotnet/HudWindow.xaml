<Window x:Class="TeachMeAI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolTip AI — Cognitive HUD"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Width="325"
        Height="435"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Modern Cyber TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#1A0D1525"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="0.8"
                                CornerRadius="5"
                                Margin="0 0 6 0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#30203550"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Chameleon Chassis: 2 Tonos Más Translúcido con Borde Dinámico Neón -->
    <Border x:Name="MainChassisBorder"
            Background="#46050A14"
            BorderBrush="#A855F7"
            BorderThickness="1.2"
            CornerRadius="16"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.90" Direction="270" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <!-- A. VISTA VERTICAL INTELIGENTE (Flotante o Sidebar Lateral) -->
            <Grid x:Name="VerticalViewContainer" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Header & Domain Badge -->
                    <RowDefinition Height="Auto"/> <!-- 1. Alert Banner (No API Key) -->
                    <RowDefinition Height="Auto"/> <!-- 2. Centerpiece: Hero Advice Card -->
                    <RowDefinition Height="*"/>    <!-- 3. Smart Details / Inline Chat -->
                    <RowDefinition Height="Auto"/> <!-- 4. Footer & Snip Trigger -->
                </Grid.RowDefinitions>

                <!-- 0. Header with Dynamic Domain Badge, Titles & Window Actions -->
                <Grid Grid.Row="0" Background="Transparent" Margin="10 8 10 4" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titles & Live Domain Identity -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Dynamic Domain Badge -->
                        <Border x:Name="DomainBadgeBorder" Background="#30A855F7" BorderBrush="#A855F7" BorderThickness="0.8" CornerRadius="4" Padding="5 2" HorizontalAlignment="Left" Margin="0 0 0 3">
                            <TextBlock x:Name="DomainBadgeText" Text="🎮 COACH GAMING // METAGAME" Foreground="#D8B4FE" FontSize="8" FontWeight="Bold"/>
                        </Border>

                        <!-- Main Element / Skill / Item Name -->
                        <TextBlock x:Name="TargetTitleText" Text="ToolTip AI Inspector" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>

                        <!-- Micro-chips: Process, Value, Verdict -->
                        <WrapPanel Orientation="Horizontal" Margin="0 3 0 0">
                            <Border x:Name="ProcessBadgeBorder" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="0.8" CornerRadius="3" Padding="4 1">
                                <TextBlock x:Name="ProcessBadgeText" Text="explorer.exe" Foreground="#E2E8F0" FontSize="8" FontWeight="Bold"/>
                            </Border>

                            <Border x:Name="ValueBadgeBorder" Background="#2538BDF8" BorderBrush="#38BDF8" BorderThickness="0.8" CornerRadius="3" Padding="4 1" Margin="4 0 0 0" Visibility="Collapsed">
                                <TextBlock x:Name="ValueBadgeText" Text="0.00 dB" Foreground="#38BDF8" FontSize="8" FontWeight="Bold"/>
                            </Border>

                            <Border Background="#1A000000" BorderBrush="#25FFFFFF" BorderThickness="0.8" CornerRadius="3" Padding="4 1" Margin="4 0 0 0">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="VerdictIndicatorDot" Width="5" Height="5" CornerRadius="2.5" Background="#00F5A0" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="VerdictLabelText" Text="Verificado" Foreground="#CBD5E1" FontSize="8" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="ConfidenceText" Text=" • 99.8%" Foreground="#64748B" FontSize="8" Margin="4 0 0 0" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Action Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnMorphOrientation" Content="⇄" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnMorphOrientation_Click" ToolTip="Alternar Vista Panorámica Horizontal / Vertical"/>
                        <Button x:Name="BtnSettings" Content="⚙️" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnSettings_Click" ToolTip="Ajustes (Ctrl+Shift+C)"/>
                        <Button x:Name="BtnPin" Content="📌" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnPin_Click" ToolTip="Fijar posición"/>
                        <Button x:Name="BtnClose" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnClose_Click" ToolTip="Cerrar (Esc)"/>
                    </StackPanel>
                </Grid>

                <!-- 1. Alert Banner when No API Key -->
                <Border x:Name="NoKeyNoticeBanner" Grid.Row="1" Margin="10 2 10 4" Background="#D0281A08" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="6 5" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚠️" FontSize="12" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MODO LOCAL ACTIVO • IA INACTIVA" Foreground="#F59E0B" FontWeight="Bold" FontSize="8"/>
                        <TextBlock Text="Ingresa tu clave del proveedor elegido para activar la asesoría táctica." Foreground="#E2E8F0" FontSize="7.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BtnOpenSettingsFromBanner" Grid.Column="2" Background="#F59E0B" Cursor="Hand" Margin="4 0 0 0" Padding="5 2" Click="BtnOpenSettingsFromBanner_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Configurar" Foreground="#080D1A" FontWeight="Bold" FontSize="8"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. CENTERPIECE: EL CONSEJO DEL MAESTRO (Hero Advice Card al Frente) -->
                <Border x:Name="AdviceCardBorder" Grid.Row="2" Margin="10 4 10 6" Background="#C0080E1C" BorderBrush="#50A855F7" BorderThickness="1.2" CornerRadius="8" Padding="8 7">
                    <StackPanel>
                        <Grid Margin="0 0 0 3">
                            <TextBlock x:Name="AdviceCardTitle" Text="⚡ CONSEJO TÁCTICO DEL MAESTRO" Foreground="#A855F7" FontWeight="Bold" FontSize="8.5"/>
                        </Grid>
                        <TextBlock x:Name="TeacherGuideText" Text="Selecciona cualquier elemento para recibir asesoría experta en tiempo real." Foreground="#FFFFFF" FontSize="9.5" LineHeight="13.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. Smart Details & Inline Chat Tabs -->
                <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="10 0 10 0">
                    <!-- SUB-TAB 1: QUÉ ES Y CONTEXTO -->
                    <TabItem Header="🏷️ Qué es">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0 4 0 0">
                            <StackPanel>
                                <!-- Tooltip nativo registrado en Windows -->
                                <TextBlock x:Name="NativeHelpLabel" Text="AYUDA NATIVA DE LA APP" Foreground="#38BDF8" FontSize="8" FontWeight="Bold" Margin="0 0 0 2" Visibility="Collapsed"/>
                                <Border x:Name="NativeHelpBorder" Background="#C0061222" BorderBrush="#4038BDF8" BorderThickness="0.8" CornerRadius="5" Padding="6 4" Margin="0 0 0 6" Visibility="Collapsed">
                                    <TextBlock x:Name="NativeHelpTextContent" Text="" Foreground="#E0F2FE" FontSize="9" FontWeight="Medium" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="RESUMEN DIDÁCTICO" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                                <TextBlock x:Name="SummaryText" Text="Elemento inspeccionado de Windows." Foreground="#FFFFFF" FontSize="9.5" LineHeight="13.5" TextWrapping="Wrap" Margin="0 0 0 6"/>

                                <TextBlock Text="CONSECUENCIAS &amp; IMPACTO" Foreground="#94A3B8" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                                <TextBlock x:Name="ConsequencesText" Text="Interacción segura en el espacio de usuario." Foreground="#CBD5E1" FontSize="9" TextWrapping="Wrap" Margin="0 0 0 4"/>
                                <TextBlock x:Name="ImpactText" Text="" Foreground="#94A3B8" FontSize="8.5" TextWrapping="Wrap" Margin="0 0 0 4"/>

                                <TextBlock x:Name="OcrTextContent" Text="" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SUB-TAB 2: SPECS, ATAJO & CLI -->
                    <TabItem Header="⚙️ Specs">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0 4 0 0">
                            <StackPanel>
                                <Grid Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TIPO DE CONTROL" Foreground="#64748B" FontSize="7.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="ControlTypeText" Text="UIElement" Foreground="#00F5A0" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" x:Name="ParentModulePanel" Visibility="Collapsed">
                                        <TextBlock Text="MÓDULO PADRE" Foreground="#64748B" FontSize="7.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="ParentModuleText" Text="MainRack" Foreground="#F59E0B" FontSize="8.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="NativeValuePanel" Visibility="Collapsed" Margin="0 0 0 4">
                                    <TextBlock Text="VALOR NATIVO" Foreground="#64748B" FontSize="7.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="NativeValueText" Text="0.00 dB" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas"/>
                                </StackPanel>

                                <TextBlock Text="ATAJO SUGERIDO" Foreground="#64748B" FontSize="7.5" FontWeight="Bold" Margin="0 2 0 1"/>
                                <TextBlock x:Name="AccessKeyText" Text="Ctrl+Shift+A Recortar • Ctrl+Shift+D Radar" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" Margin="0 0 0 4"/>

                                <Grid Margin="0 2 0 2">
                                    <TextBlock Text="COMANDO CLI" Foreground="#64748B" FontSize="7.5" FontWeight="Bold"/>
                                    <Button x:Name="BtnCopyCli" Content="Copiar" HorizontalAlignment="Right" Background="Transparent" Foreground="#00F5A0" BorderThickness="0" Cursor="Hand" FontSize="8" FontWeight="Bold" Click="BtnCopyCli_Click"/>
                                </Grid>
                                <TextBox x:Name="CliBox" Text="Get-Process" Background="#B0030710" Foreground="#38BDF8" FontFamily="Consolas" FontSize="8" BorderBrush="#2538BDF8" Padding="4" IsReadOnly="True" TextWrapping="Wrap" Margin="0 0 0 4"/>

                                <TextBlock x:Name="SignStatusText" Text="Binario Verificado" Foreground="#64748B" FontSize="7.5" Margin="0 0 0 2"/>
                                <TextBox x:Name="ExePathBox" Text="" Background="#B0030710" Foreground="#94A3B8" FontFamily="Consolas" FontSize="7.5" BorderBrush="#20FFFFFF" Padding="3" IsReadOnly="True" Margin="0 0 0 2"/>
                                <TextBlock x:Name="ResourcesText" Text="" Foreground="#64748B" FontSize="7.5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SUB-TAB 3: CHAT CON EL MAESTRO -->
                    <TabItem Header="💬 Preguntar">
                        <Grid Margin="0 4 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0 0 0 4">
                                <StackPanel x:Name="ChatMessagesPanel">
                                    <Border Background="#B8081220" BorderBrush="#3000F5A0" BorderThickness="0.8" CornerRadius="5" Padding="6" Margin="0 0 0 4">
                                        <TextBlock Text="🧠 Pregúntame dudas tácticas, combinaciones de armas, ajustes de ecualización o código sobre este elemento." Foreground="#F1F5F9" FontSize="8.5" TextWrapping="Wrap" LineHeight="12"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Chat Input Box -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#141C2A" BorderBrush="#30FFFFFF" BorderThickness="0.8" CornerRadius="5">
                                    <TextBox x:Name="ChatInputBox" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="5 3" FontSize="9" KeyDown="ChatInputBox_KeyDown"/>
                                </Border>
                                <Button x:Name="BtnSendChat" Grid.Column="1" Background="#00F5A0" Margin="4 0 0 0" Cursor="Hand" Click="BtnSendChat_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="7 3">
                                                <TextBlock Text="Enviar" Foreground="#060811" FontWeight="Bold" FontSize="9"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- 4. Footer & Snip Trigger -->
                <Grid Grid.Row="4" Margin="10 4 10 6">
                    <TextBlock x:Name="StatusFooterText" Text="Ctrl+Shift+A: Recortar • Ctrl+Shift+D: Radar" Foreground="#64748B" FontSize="8"/>
                    <Button x:Name="BtnTriggerSnip" Content="⚡ Recortar" HorizontalAlignment="Right" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" FontSize="8" Click="BtnTriggerSnip_Click"/>
                </Grid>
            </Grid>

            <!-- B. VISTA HORIZONTAL PANORÁMICA (Ticker Inferior 3 Columnas) -->
            <Grid x:Name="HorizontalRibbonContainer" Visibility="Collapsed" Margin="8 6" Background="Transparent" MouseLeftButtonDown="Ribbon_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="135"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: Identidad y Micro-Chips -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 8 0">
                    <Border x:Name="DomainBadgeBorderH" Background="#30A855F7" BorderBrush="#A855F7" BorderThickness="0.8" CornerRadius="4" Padding="5 2" HorizontalAlignment="Left" Margin="0 0 0 3">
                        <TextBlock x:Name="DomainBadgeTextH" Text="🎮 COACH GAMING // METAGAME" Foreground="#D8B4FE" FontSize="8" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="TargetTitleTextH" Text="ToolTip AI Inspector" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Orientation="Horizontal" Margin="0 3 0 0">
                        <Border x:Name="ProcessBadgeBorderH" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="0.8" CornerRadius="3" Padding="4 1">
                            <TextBlock x:Name="ProcessBadgeTextH" Text="explorer.exe" Foreground="#E2E8F0" FontSize="8" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="ValueBadgeBorderH" Background="#2538BDF8" BorderBrush="#38BDF8" BorderThickness="0.8" CornerRadius="3" Padding="4 1" Margin="4 0 0 0" Visibility="Collapsed">
                            <TextBlock x:Name="ValueBadgeTextH" Text="0.00 dB" Foreground="#38BDF8" FontSize="8" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#1A000000" BorderBrush="#25FFFFFF" BorderThickness="0.8" CornerRadius="3" Padding="4 1" Margin="4 0 0 0">
                            <TextBlock x:Name="VerdictLabelTextH" Text="Verificado" Foreground="#CBD5E1" FontSize="8"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Col 1: Hero Advice Banner Panorámico -->
                <Border x:Name="AdviceCardBorderH" Grid.Column="1" Background="#C0080E1C" BorderBrush="#50A855F7" BorderThickness="1.2" CornerRadius="8" Padding="10 6" Margin="0 0 8 0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="AdviceCardTitleH" Text="⚡ CONSEJO TÁCTICO DEL MAESTRO" Foreground="#A855F7" FontWeight="Bold" FontSize="8" Margin="0 0 0 2"/>
                            <TextBlock x:Name="TeacherGuideTextH" Text="Selecciona cualquier elemento para recibir asesoría experta en tiempo real." Foreground="#FFFFFF" FontSize="9.5" LineHeight="13.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Col 2: Atajos y Acciones Rápidas -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 6">
                        <Button x:Name="BtnMorphOrientationH" Content="⇄" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnMorphOrientation_Click" ToolTip="Alternar Vista Vertical / Horizontal"/>
                        <Button x:Name="BtnPinH" Content="📌" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnPin_Click" ToolTip="Fijar posición"/>
                        <Button x:Name="BtnCloseH" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnClose_Click" ToolTip="Cerrar (Esc)"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="BtnTriggerSnipH" Background="#141C2A" BorderBrush="#38BDF8" BorderThickness="0.8" Foreground="#38BDF8" FontSize="8.5" FontWeight="Bold" Padding="6 3" Cursor="Hand" Click="BtnTriggerSnip_Click" Margin="0 0 0 3">
                            <TextBlock Text="⚡ Recortar (Ctrl+Shift+A)" HorizontalAlignment="Center"/>
                        </Button>
                        <TextBlock x:Name="AccessKeyTextH" Text="Ctrl+Shift+D: Radar" Foreground="#64748B" FontSize="7.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- C. Settings Drawer (Accesible Globalmente con Ctrl+Shift+C) -->
            <Border x:Name="SettingsDrawer" Background="#F0080D1A" BorderBrush="#00F5A0" BorderThickness="1.2" CornerRadius="10" Margin="4" Padding="8" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0 0 0 6">
                            <TextBlock Text="Ajustes de IA y Parámetros (Ctrl+Shift+C)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnCloseSettings_Click"/>
                        </Grid>

                        <TextBlock Text="PROVEEDOR DE IA" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                        <ComboBox x:Name="ProviderCombo" Background="#141C2A" Foreground="#000000" Padding="3" FontSize="9" Margin="0 0 0 3" SelectionChanged="ProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="Gemini" IsSelected="True"/>
                            <ComboBoxItem Content="OpenAI"/>
                            <ComboBoxItem Content="Azure OpenAI"/>
                            <ComboBoxItem Content="OpenRouter"/>
                            <ComboBoxItem Content="Claude"/>
                        </ComboBox>

                        <TextBlock Margin="0 0 0 4">
                            <Hyperlink x:Name="ProviderLink" NavigateUri="https://aistudio.google.com/app/apikey" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#00F5A0" FontSize="8" TextDecorations="None" Cursor="Hand">
                                Obtener clave del proveedor ↗
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Text="API KEY" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                        <PasswordBox x:Name="ApiKeyBox" Background="#141C2A" Foreground="#FFFFFF" BorderBrush="#22FFFFFF" Padding="4" FontSize="9" Margin="0 0 0 3"/>

                        <StackPanel x:Name="AzureFieldsPanel" Visibility="Collapsed" Margin="0 0 0 4">
                            <TextBlock Text="AZURE ENDPOINT" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBox x:Name="AzureEndpointBox" Background="#141C2A" Foreground="#FFFFFF" BorderBrush="#22FFFFFF" Padding="4" FontSize="8.5" Margin="0 0 0 3" ToolTip="https://mi-recurso.openai.azure.com"/>
                            <TextBlock Text="DEPLOYMENT" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBox x:Name="AzureDeploymentBox" Background="#141C2A" Foreground="#FFFFFF" BorderBrush="#22FFFFFF" Padding="4" FontSize="8.5" Margin="0 0 0 3" ToolTip="Nombre del deployment de Azure OpenAI"/>
                        </StackPanel>

                        <TextBlock Text="MODELO DE IA" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                        <ComboBox x:Name="ModelCombo" Background="#141C2A" Foreground="#000000" Padding="3" FontSize="9" Margin="0 0 0 5"/>

                        <TextBlock Text="MODO DE AJUSTE DIDÁCTICO" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                        <ComboBox x:Name="AnalysisModeCombo" Background="#141C2A" Foreground="#000000" Padding="3" FontSize="9" Margin="0 0 0 5">
                            <ComboBoxItem Content="Maestro &amp; Guía de Acciones" IsSelected="True"/>
                            <ComboBoxItem Content="Auditor Técnico &amp; Código"/>
                            <ComboBoxItem Content="Alto Contraste OCR"/>
                        </ComboBox>

                        <TextBlock Text="TIEMPO RADAR DWELL" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 2"/>
                        <Grid Margin="0 0 0 6">
                            <Slider x:Name="DwellSlider" Minimum="1.5" Maximum="5" Value="3" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DwellSlider_ValueChanged"/>
                            <TextBlock x:Name="DwellValueLabel" Text="3.0 seg" Foreground="#00F5A0" HorizontalAlignment="Right" FontSize="8"/>
                        </Grid>

                        <Button x:Name="BtnSaveSettings" Background="#00F5A0" Cursor="Hand" Click="BtnSaveSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="8 5">
                                        <TextBlock Text="Guardar Ajustes" Foreground="#060811" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
