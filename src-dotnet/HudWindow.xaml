<Window x:Class="TeachMeAI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeachMe AI HUD"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Width="295"
        Height="410"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Modern ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Modern TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0 0 0 2"
                                Margin="0 0 6 0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00F5A0"/>
                                <Setter Property="Foreground" Value="#00F5A0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Translucent Acrylic Card Body -->
    <Border Background="#80080D1A"
            BorderBrush="#5500F5A0"
            BorderThickness="1.2"
            CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Color="#000000" Opacity="0.80" Direction="270" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Verdict Bar -->
                <RowDefinition Height="*"/>    <!-- Tab Views / Content -->
                <RowDefinition Height="Auto"/> <!-- Footer / Settings Drawer -->
            </Grid.RowDefinitions>

            <!-- 1. Header with Drag Handle, Title & Actions (Thumbnail removed per user request) -->
            <Grid Grid.Row="0" Background="Transparent" Margin="10 8 10 6" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titles -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TargetTitleText" Text="TeachMe AI Inspector" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0 1 0 0">
                        <Border Background="#1A00F5A0" BorderBrush="#00F5A0" BorderThickness="0.6" CornerRadius="3" Padding="3 1">
                            <TextBlock x:Name="ProcessBadgeText" Text="explorer.exe" Foreground="#00F5A0" FontSize="8.5" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="ConfidenceText" Text=" • 99.8%" Foreground="#94A3B8" FontSize="8.5" Margin="4 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Icons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSettings" Content="⚙️" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnSettings_Click" ToolTip="Ajustes (Ctrl+Shift+C)"/>
                    <Button x:Name="BtnPin" Content="📌" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnPin_Click" ToolTip="Fijar posición"/>
                    <Button x:Name="BtnClose" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnClose_Click" ToolTip="Cerrar (Esc)"/>
                </StackPanel>
            </Grid>

            <!-- 2. Verdict & Context Bar -->
            <Border Grid.Row="1" Margin="10 0 10 6" Background="#121826" BorderBrush="#22FFFFFF" BorderThickness="0.8" CornerRadius="6" Padding="8 5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="VerdictIndicatorDot" Grid.Column="0" Width="6" Height="6" CornerRadius="3" Background="#00F5A0" Margin="0 0 6 0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VerdictLabelText" Grid.Column="1" Text="Elemento verificado del sistema operativo" Foreground="#F1F5F9" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- 3. Tabs: 5 Dimensions of Cognition -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="10 0 10 0">
                <!-- TAB 1: QUÉ ES -->
                <TabItem Header="🏷️ Qué es">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0 6 0 0">
                        <StackPanel>
                            <TextBlock Text="RESUMEN" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBlock x:Name="SummaryText" Text="Elemento inspeccionado de Windows 11." Foreground="#CBD5E1" FontSize="10" LineHeight="14" TextWrapping="Wrap" Margin="0 0 0 8"/>

                            <TextBlock Text="TIPO DE CONTROL" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBlock x:Name="ControlTypeText" Text="UIA_WindowSurface" Foreground="#00F5A0" FontSize="9.5" FontFamily="Consolas" Margin="0 0 0 8"/>

                            <TextBlock Text="TEXTO VISIBLE (OCR)" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <Border Background="#0A0E18" BorderBrush="#1C2638" BorderThickness="0.8" CornerRadius="5" Padding="6">
                                <TextBlock x:Name="OcrTextContent" Text="[Sin texto capturado]" Foreground="#94A3B8" FontSize="9.5" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: MAESTRO & QUÉ PUEDES HACER -->
                <TabItem Header="⚡ Maestro">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0 6 0 0">
                        <StackPanel>
                            <TextBlock Text="💡 ¿QUÉ PUEDES HACER CON ESTO?" Foreground="#00F5A0" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <Border Background="#101C26" BorderBrush="#3000F5A0" BorderThickness="0.8" CornerRadius="6" Padding="6" Margin="0 0 0 8">
                                <TextBlock x:Name="TeacherGuideText" Text="• Haz clic para activar o enfocar la aplicación.&#x0a;• Consulta dudas técnicas en la pestaña 'Tutor IA'.&#x0a;• Copia comandos de inspección en 'CLI'." Foreground="#E2E8F0" FontSize="9.5" LineHeight="14" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="CONSECUENCIAS DE INTERACCIÓN" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBlock x:Name="ConsequencesText" Text="Interactuar transmitirá eventos nativos de mouse y teclado." Foreground="#CBD5E1" FontSize="9.5" LineHeight="14" TextWrapping="Wrap" Margin="0 0 0 6"/>

                            <TextBlock Text="IMPACTO EN EL SISTEMA" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBlock x:Name="ImpactText" Text="Consumo estándar sin elevación de privilegios." Foreground="#CBD5E1" FontSize="9.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: SEGURIDAD & FIRMA -->
                <TabItem Header="🛡️ Specs">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0 6 0 0">
                        <StackPanel>
                            <TextBlock Text="FIRMA DIGITAL" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBlock x:Name="SignStatusText" Text="Authenticode Verificado • Microsoft Windows" Foreground="#00F5A0" FontSize="9.5" FontWeight="SemiBold" Margin="0 0 0 6"/>

                            <TextBlock Text="RUTA DEL EJECUTABLE" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBox x:Name="ExePathBox" Text="C:\Windows\System32\explorer.exe" Background="#0A0E18" Foreground="#94A3B8" FontFamily="Consolas" FontSize="8.5" BorderBrush="#1C2638" Padding="4" IsReadOnly="True" Margin="0 0 0 6"/>

                            <TextBlock Text="RECURSOS ESTIMADOS" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBlock x:Name="ResourcesText" Text="CPU: ~0.1% | Memoria estándar" Foreground="#CBD5E1" FontSize="9.5"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: CLI & POWERSHELL -->
                <TabItem Header="⌨️ CLI">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0 6 0 0">
                        <StackPanel>
                            <Grid Margin="0 0 0 3">
                                <TextBlock Text="POWERSHELL EQUIVALENTE" Foreground="#64748B" FontSize="8.5" FontWeight="Bold"/>
                                <Button x:Name="BtnCopyCli" Content="Copiar" HorizontalAlignment="Right" Background="Transparent" Foreground="#00F5A0" BorderThickness="0" Cursor="Hand" FontSize="8.5" Click="BtnCopyCli_Click"/>
                            </Grid>
                            <TextBox x:Name="CliBox" Text="Get-Process | Select-Object Id, ProcessName" Background="#0A0E18" Foreground="#38BDF8" FontFamily="Consolas" FontSize="8.5" BorderBrush="#1C2638" Padding="6" IsReadOnly="True" TextWrapping="Wrap" Margin="0 0 0 8"/>

                            <TextBlock Text="ATAJO RECOMENDADO" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                            <TextBlock x:Name="AccessKeyText" Text="Ctrl + A (Recortar) • Ctrl + D (Radar) • Ctrl + Shift + C (Ajustes)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: TUTOR IA / CHAT INTERACTIVO -->
                <TabItem Header="🤖 Tutor IA">
                    <Grid Margin="0 6 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chat Messages -->
                        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0 0 0 6">
                            <StackPanel x:Name="ChatMessagesPanel">
                                <Border Background="#121826" CornerRadius="6" Padding="6" Margin="0 0 0 4">
                                    <TextBlock Text="¡Hola! Soy tu Maestro IA. Pregúntame qué hace este elemento o cómo automatizarlo." Foreground="#CBD5E1" FontSize="9.5" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Input Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0A0E18" BorderBrush="#22FFFFFF" BorderThickness="0.8" CornerRadius="5">
                                <TextBox x:Name="ChatInputBox" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="5 3" FontSize="9.5" KeyDown="ChatInputBox_KeyDown"/>
                            </Border>
                            <Button x:Name="BtnSendChat" Grid.Column="1" Background="#00F5A0" Margin="4 0 0 0" Cursor="Hand" Click="BtnSendChat_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="8 3">
                                            <TextBlock Text="Enviar" Foreground="#060811" FontWeight="Bold" FontSize="9.5"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 4. Settings Drawer / Image & AI Adjustment (Ctrl + Shift + C) -->
            <Border x:Name="SettingsDrawer" Grid.Row="2" Grid.RowSpan="2" Background="#A0080D1A" BorderBrush="#00F5A0" BorderThickness="1" CornerRadius="10" Margin="6" Padding="10" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0 0 0 8">
                            <TextBlock Text="Ajustes de Imagen &amp; IA (Ctrl + Shift + C)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5"/>
                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnCloseSettings_Click"/>
                        </Grid>

                        <TextBlock Text="API KEY DE GEMINI" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                        <PasswordBox x:Name="ApiKeyBox" Background="#141C2A" Foreground="#FFFFFF" BorderBrush="#22FFFFFF" Padding="4" FontSize="9.5" Margin="0 0 0 6"/>

                        <TextBlock Text="MODELO DE IA" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                        <ComboBox x:Name="ModelCombo" Background="#141C2A" Foreground="#000000" Padding="4" FontSize="9.5" Margin="0 0 0 6">
                            <ComboBoxItem Content="gemini-flash-latest" IsSelected="True"/>
                            <ComboBoxItem Content="gemini-3.8-flash"/>
                            <ComboBoxItem Content="gemini-3.6-flash"/>
                            <ComboBoxItem Content="gemini-pro-latest"/>
                            <ComboBoxItem Content="gemini-3.1-pro-preview"/>
                        </ComboBox>

                        <TextBlock Text="MODO DE AJUSTE DIDÁCTICO" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                        <ComboBox x:Name="AnalysisModeCombo" Background="#141C2A" Foreground="#000000" Padding="4" FontSize="9.5" Margin="0 0 0 6">
                            <ComboBoxItem Content="Maestro &amp; Guía de Acciones" IsSelected="True"/>
                            <ComboBoxItem Content="Auditor Técnico &amp; Código"/>
                            <ComboBoxItem Content="Alto Contraste OCR"/>
                        </ComboBox>

                        <TextBlock Text="TIEMPO RADAR DWELL" Foreground="#64748B" FontSize="8.5" FontWeight="Bold" Margin="0 0 0 2"/>
                        <Grid Margin="0 0 0 8">
                            <Slider x:Name="DwellSlider" Minimum="1.5" Maximum="5" Value="3" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DwellSlider_ValueChanged"/>
                            <TextBlock x:Name="DwellValueLabel" Text="3.0 seg" Foreground="#00F5A0" HorizontalAlignment="Right" FontSize="8.5"/>
                        </Grid>

                        <Button x:Name="BtnSaveSettings" Background="#00F5A0" Cursor="Hand" Click="BtnSaveSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="8 6">
                                        <TextBlock Text="Guardar Ajustes" Foreground="#060811" FontWeight="Bold" FontSize="9.5" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Bottom Status Footer -->
            <Grid Grid.Row="3" Margin="10 6 10 6">
                <TextBlock x:Name="StatusFooterText" Text="Ctrl+A: Recortar • Ctrl+D: Radar • Ctrl+Shift+C: Ajustes" Foreground="#64748B" FontSize="8.5"/>
                <Button x:Name="BtnTriggerSnip" Content="⚡ Recortar" HorizontalAlignment="Right" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" FontSize="8.5" Click="BtnTriggerSnip_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
