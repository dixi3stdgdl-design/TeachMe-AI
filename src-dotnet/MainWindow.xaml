<Window x:Class="TeachMeAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolTip AI — Dynamic Island Capsule"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFFFFF"
        Width="500"
        Height="46"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <Style x:Key="CapsuleButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1F2E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#243044"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4038BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="#50050A14"
            BorderBrush="#3800F5A0"
            BorderThickness="1.2"
            CornerRadius="23"
            Margin="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.85" Direction="270" ShadowDepth="3"/>
        </Border.Effect>
        <Grid>
            <!-- A. VISTA HORIZONTAL INTELIGENTE (Cápsula Superior, Inferior o Flotante) -->
            <Grid x:Name="HorizontalCapsuleContainer" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/> <!-- Always visible compact capsule bar -->
                    <RowDefinition Height="*"/>  <!-- Expandable tool drawer -->
                </Grid.RowDefinitions>

                <!-- Row 0: Capsule Bar -->
                <Grid Grid.Row="0" Margin="10 0 10 0" Background="Transparent" MouseLeftButtonDown="Capsule_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Logo / Drag Handle -->
                        <ColumnDefinition Width="*"/>    <!-- Center Actions: Radar + Snip -->
                        <ColumnDefinition Width="Auto"/> <!-- Right Actions: Pin + Expand + Close -->
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Brand, Drag & Live Domain Radar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Arrastrar para mover la cápsula a cualquier parte de la pantalla">
                        <TextBlock Text="🧠" FontSize="13" VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <TextBlock Text="ToolTip AI" FontWeight="Bold" FontSize="11" Foreground="#00F5A0" VerticalAlignment="Center"/>
                        <Border x:Name="CapsuleDomainPill" Background="#2538BDF8" BorderBrush="#38BDF8" BorderThickness="0.8" CornerRadius="8" Padding="5 1" Margin="6 0 0 0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CapsuleDomainIcon" Text="🧠" FontSize="8" Margin="0 0 3 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CapsuleDomainLabel" Text="Windows" Foreground="#38BDF8" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Col 1: Center Quick Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Radar Toggle Pill -->
                        <Border x:Name="BtnToggleRadarBorder" Background="#141C2A" BorderBrush="#22FFFFFF" BorderThickness="0.8" CornerRadius="12" Margin="4 0" Padding="8 4" Cursor="Hand" MouseLeftButtonDown="BtnToggleRadar_MouseDown" ToolTip="Radar Automático al reposar cursor (Ctrl+Shift+D)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="RadarDot" Width="6" Height="6" CornerRadius="3" Background="#64748B" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RadarStatusLabel" Text="Radar: OFF" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Snip Button Pill -->
                        <Button x:Name="BtnStartSnip" Background="#00F5A0" Foreground="#040810" FontWeight="Bold" FontSize="10.5" Padding="10 4" Margin="4 0" Cursor="Hand" Click="BtnStartSnip_Click" ToolTip="Recortar y Analizar Área (Ctrl+Shift+A)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ Recortar" FontWeight="Bold" FontSize="10" Foreground="#040810"/>
                                            <TextBlock Text=" Ctrl+Shift+A" FontSize="8" Foreground="#163828" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Col 2: Expand & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin Toggle Button -->
                        <Button x:Name="BtnPin" Content="📌" Width="22" Height="22" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnPin_Click" ToolTip="Fijar Cápsula Expandida"/>
                        
                        <!-- Expand / Collapse Chevron Button -->
                        <Button x:Name="BtnExpandToggle" Content="▾" Width="22" Height="22" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" Click="BtnExpandToggle_Click" ToolTip="Mostrar/Ocultar Herramientas"/>

                        <!-- Close / Minimize to Tray -->
                        <Button x:Name="BtnClose" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnClose_Click" ToolTip="Ocultar a Barra de Tareas"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Expandable Tool Drawer (revealed when height expands) -->
                <Grid x:Name="DrawerGrid" Grid.Row="1" Margin="10 2 10 8" Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Separator -->
                    <Border Grid.Row="0" Height="0.8" Background="#20FFFFFF" Margin="0 0 0 6"/>

                    <!-- Tool Buttons Grid -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CapsuleButton}" Padding="4 4" Click="BtnFullScreen_Click" ToolTip="Captura completa de pantalla con IA">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📸 Pantalla" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource CapsuleButton}" Padding="4 4" Click="BtnClipboard_Click" ToolTip="Analizar imagen o texto del portapapeles">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📋 Portapapeles" FontSize="9" FontWeight="SemiBold" Foreground="#00F5A0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4" Style="{StaticResource CapsuleButton}" Padding="4 4" Click="BtnOpenHud_Click" ToolTip="Ver panel HUD de inspección">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🪟 Panel HUD" FontSize="9" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="6" Style="{StaticResource CapsuleButton}" Padding="4 4" Click="BtnSettingsQuick_Click" ToolTip="Ajustes de IA y Gemini">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚙️ Ajustes" FontSize="9" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Footer Shortcuts hint -->
                        <TextBlock Grid.Row="1" Text="Ctrl+Shift+A Recortar  •  Ctrl+Shift+D Radar  •  Ctrl+Shift+C Ajustes" Foreground="#64748B" FontSize="8.5" HorizontalAlignment="Center" Margin="0 6 0 0"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- B. VISTA VERTICAL INTELIGENTE (Sidebar Lateral Derecho o Izquierdo) -->
            <Grid x:Name="VerticalSidebarContainer" Visibility="Collapsed" Background="Transparent" MouseLeftButtonDown="Capsule_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 6">
                    <!-- Top Logo & Drag Handle -->
                    <Border Background="#2000F5A0" BorderBrush="#3800F5A0" BorderThickness="0.8" Width="36" Height="36" CornerRadius="18" Margin="0 0 0 6" ToolTip="Arrastrar para mover (ToolTip AI)" Cursor="SizeAll">
                        <TextBlock Text="🧠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Mini Domain Chip -->
                    <Border x:Name="CapsuleDomainPillV" Background="#2538BDF8" BorderBrush="#38BDF8" BorderThickness="0.8" Width="28" Height="20" CornerRadius="6" Margin="0 0 0 8" HorizontalAlignment="Center" ToolTip="Dominio Activo">
                        <TextBlock x:Name="CapsuleDomainIconV" Text="🧠" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Height="0.8" Width="28" Background="#20FFFFFF" Margin="0 0 0 8"/>

                    <!-- Snip Button Pill -->
                    <Button x:Name="BtnStartSnipV" Width="36" Height="36" Background="#00F5A0" Cursor="Hand" Margin="0 0 0 6" Click="BtnStartSnip_Click" ToolTip="Recortar y Analizar con IA (Ctrl+Shift+A)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <TextBlock Text="⚡" FontSize="15" Foreground="#040810" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Radar Toggle Pill -->
                    <Border x:Name="BtnToggleRadarBorderV" Background="#141C2A" BorderBrush="#22FFFFFF" BorderThickness="0.8" Width="36" Height="36" CornerRadius="18" Margin="0 0 0 6" Cursor="Hand" MouseLeftButtonDown="BtnToggleRadar_MouseDown" ToolTip="Radar Automático On/Off (Ctrl+Shift+D)">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="RadarDotV" Width="7" Height="7" CornerRadius="3.5" Background="#64748B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8 -4 0 0"/>
                        </Grid>
                    </Border>

                    <!-- Quick Settings Button -->
                    <Button x:Name="BtnSettingsV" Width="32" Height="32" Style="{StaticResource CapsuleButton}" Margin="0 0 0 6" Click="BtnSettingsQuick_Click" ToolTip="Ajustes de IA (Ctrl+Shift+C)">
                        <TextBlock Text="⚙️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Pin Button -->
                    <Button x:Name="BtnPinV" Width="32" Height="32" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Margin="0 0 0 4" Click="BtnPin_Click" ToolTip="Fijar">
                        <TextBlock Text="📌" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnCloseV" Width="32" Height="32" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" ToolTip="Ocultar">
                        <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
