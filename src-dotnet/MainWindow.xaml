<Window x:Class="TeachMeAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeachMe AI — Windows 11 Native Neural Inspector"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFFFFF"
        Width="340"
        Height="415"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border x:Name="MainBorder"
            Background="#80080D1A"
            BorderBrush="#5038BDF8"
            BorderThickness="1.2"
            CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Color="#000000" Opacity="0.80" Direction="270" ShadowDepth="6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Main Dashboard -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Clean Title Bar (Transparent Background for fluid dragging) -->
            <Grid Grid.Row="0" Margin="12 10 12 4" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🧠 TeachMe AI" FontWeight="Bold" FontSize="12.5" Foreground="#00F5A0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="v2.5 Pro" FontSize="9.5" Foreground="#64748B" Margin="6 0 0 0" VerticalAlignment="Center"/>

                <!-- Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMinimize" Content="🗕" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnMinimize_Click" ToolTip="Minimizar a Barra de Tareas"/>
                    <Button x:Name="BtnMaximize" Content="🗖" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnMaximize_Click" ToolTip="Maximizar"/>
                    <Button x:Name="BtnClose" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnClose_Click" ToolTip="Ocultar a Barra de Tareas"/>
                </StackPanel>
            </Grid>

            <!-- Dashboard Body -->
            <StackPanel Grid.Row="1" Margin="12 4 12 8">
                <!-- Status Banner -->
                <Border Background="#101827" BorderBrush="#22FFFFFF" BorderThickness="0.8" CornerRadius="8" Padding="8 6" Margin="0 0 0 6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#00F5A0" Margin="0 0 8 0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Servicio de Inspección Activo" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="Ctrl + A para recortar • Ctrl + D para radar" Foreground="#94A3B8" FontSize="9.5" Margin="0 1 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid Margin="0 0 0 6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Background="#00F5A0" Foreground="#060811" FontWeight="Bold" FontSize="11" Padding="8 8" Cursor="Hand" Click="BtnStartSnip_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Recortar" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ctrl + A" FontSize="8.5" Opacity="0.85" HorizontalAlignment="Center" Margin="0 1 0 0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Background="#141C2A" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="0.8" FontWeight="SemiBold" FontSize="10.5" Padding="8 8" Cursor="Hand" Click="BtnOpenHud_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🪟 Panel HUD" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ajustes (Ctrl+Shift+C)" FontSize="8" Opacity="0.8" HorizontalAlignment="Center" Margin="0 1 0 0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Controles & Radar Switch -->
                <Border Background="#0A0E18" BorderBrush="#1C2638" BorderThickness="0.8" CornerRadius="6" Padding="8 5" Margin="0 0 0 6">
                    <StackPanel>
                        <!-- Toggle Radar Automático -->
                        <Border x:Name="BtnToggleRadarBorder" Background="#141C2A" BorderBrush="#22FFFFFF" BorderThickness="0.8" CornerRadius="5">
                            <Button x:Name="BtnToggleRadar" Background="Transparent" BorderThickness="0" Padding="6 4" Cursor="Hand" Click="BtnToggleRadar_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RadarDot" Grid.Column="0" Width="6" Height="6" CornerRadius="3" Background="#64748B" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RadarStatusLabel" Grid.Column="1" Text="Radar Automático: APAGADO" Foreground="#94A3B8" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1A38BDF8" CornerRadius="3" Padding="4 1">
                                        <TextBlock Text="Ctrl+D" Foreground="#38BDF8" FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Herramientas Rápidas -->
                <Border Background="#0A0E18" BorderBrush="#1C2638" BorderThickness="0.8" CornerRadius="6" Padding="8 6">
                    <StackPanel>
                        <TextBlock Text="HERRAMIENTAS RÁPIDAS" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 4"/>
                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Background="#141C2A" BorderBrush="#22FFFFFF" BorderThickness="0.8" Foreground="#38BDF8" FontSize="9" Padding="4 4" Cursor="Hand" Click="BtnFullScreen_Click" ToolTip="Captura toda la pantalla y la analiza con IA">
                                <TextBlock Text="📸 Pantalla Completa" HorizontalAlignment="Center"/>
                            </Button>

                            <Button Grid.Column="2" Background="#141C2A" BorderBrush="#22FFFFFF" BorderThickness="0.8" Foreground="#00F5A0" FontSize="9" Padding="4 4" Cursor="Hand" Click="BtnClipboard_Click" ToolTip="Analiza la imagen o texto que tengas en el portapapeles">
                                <TextBlock Text="📋 Portapapeles" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0 0 0 4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ajustes Rápidos -->
                            <Button Grid.Column="0" Background="#141C2A" BorderBrush="#22FFFFFF" BorderThickness="0.8" Foreground="#F59E0B" FontSize="8.5" Padding="4 4" Cursor="Hand" Click="BtnSettingsQuick_Click" ToolTip="Abrir ajustes de IA y modelos">
                                <TextBlock Text="⚙️ Ajustes de IA" HorizontalAlignment="Center"/>
                            </Button>

                            <!-- Minimizar a la barra de tareas -->
                            <Button Grid.Column="2" Background="#141C2A" BorderBrush="#22FFFFFF" BorderThickness="0.8" Foreground="#CBD5E1" FontSize="8.5" Padding="4 4" Cursor="Hand" Click="BtnSendToTray_Click" ToolTip="Alojar la aplicación directamente en la barra de tareas">
                                <TextBlock Text="🔽 A la Barra Tareas" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0A0E18" CornerRadius="0 0 14 14" Padding="12 6">
                <Grid>
                    <TextBlock Text="TeachMe AI • Alojado en Barra de Tareas" Foreground="#64748B" FontSize="9" VerticalAlignment="Center"/>
                    <Button Content="Salir" HorizontalAlignment="Right" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="9.5" Click="BtnQuit_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
