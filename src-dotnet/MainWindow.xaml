<Window x:Class="TeachMeAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeachMe AI — Windows 11 Native Neural Inspector"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFFFFF"
        Width="325"
        Height="285"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border Background="#D0080D1A"
            BorderBrush="#4038BDF8"
            BorderThickness="1.2"
            CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Color="#000000" Opacity="0.80" Direction="270" ShadowDepth="6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Main Dashboard -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Fluent Title Bar -->
            <Grid Grid.Row="0" Margin="12 10 12 6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon & Brand -->
                <Border Grid.Column="0" Width="24" Height="24" Background="#161E2E" BorderBrush="#00F5A0" BorderThickness="0.8" CornerRadius="6" Margin="0 0 8 0">
                    <TextBlock Text="🧠" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TeachMe " Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="AI" Foreground="#00F5A0" FontWeight="Bold" FontSize="12"/>
                        <Border Background="#1A00F5A0" BorderBrush="#00F5A0" BorderThickness="0.5" CornerRadius="3" Padding="3 1" Margin="6 0 0 0">
                            <TextBlock Text="WPF" Foreground="#00F5A0" FontSize="8" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Neural Screen Inspector" Foreground="#64748B" FontSize="9"/>
                </StackPanel>

                <!-- Window Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="─" Width="22" Height="22" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnMinimize_Click"/>
                    <Button Content="✕" Width="22" Height="22" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Dashboard Content -->
            <StackPanel Grid.Row="1" Margin="12 6 12 6">
                <!-- Status Card -->
                <Border Background="#101624" BorderBrush="#22FFFFFF" BorderThickness="0.8" CornerRadius="8" Padding="10 7" Margin="0 0 0 8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#00F5A0" Margin="0 0 8 0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Servicio de Inspección Activo" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="Shift + A para recortar • Shift + C para ajustes" Foreground="#94A3B8" FontSize="9.5" Margin="0 1 0 0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Background="#00F5A0" Foreground="#060811" FontWeight="Bold" FontSize="10.5" BorderThickness="0" Padding="8 10" Cursor="Hand" Click="BtnTriggerSnipping_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Recortar" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Shift + A" FontSize="8.5" Opacity="0.8" HorizontalAlignment="Center" Margin="0 1 0 0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Background="#141C2A" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="0.8" FontWeight="SemiBold" FontSize="10.5" Padding="8 10" Cursor="Hand" Click="BtnOpenHud_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🪟 Panel HUD" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ajustes (Shift+C)" FontSize="8.5" Opacity="0.8" HorizontalAlignment="Center" Margin="0 1 0 0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Feature Pills -->
                <Border Background="#0A0E18" BorderBrush="#1C2638" BorderThickness="0.8" CornerRadius="6" Padding="8 6">
                    <StackPanel>
                        <TextBlock Text="CARACTERÍSTICAS ACTIVAS" Foreground="#64748B" FontSize="8" FontWeight="Bold" Margin="0 0 0 4"/>
                        <TextBlock Text="• Recorte global: Shift + A" Foreground="#CBD5E1" FontSize="9.5" Margin="0 0 0 2"/>
                        <TextBlock Text="• Ajustes de imagen &amp; IA: Shift + C" Foreground="#38BDF8" FontSize="9.5" Margin="0 0 0 2"/>
                        <TextBlock Text="• Radar reposo: 3.0s (silenciado al teclear)" Foreground="#CBD5E1" FontSize="9.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0A0E18" CornerRadius="0 0 14 14" Padding="12 6">
                <Grid>
                    <TextBlock Text="TeachMe AI • 100% Nativo C# WPF" Foreground="#64748B" FontSize="9" VerticalAlignment="Center"/>
                    <Button Content="Salir" HorizontalAlignment="Right" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Cursor="Hand" FontSize="9.5" Click="BtnQuit_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
