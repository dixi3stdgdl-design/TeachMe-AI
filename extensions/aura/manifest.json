{
  "manifest_version": 3,
  "name": "ToolTip AI Aura",
  "version": "1.0.2",
  "description": "Escudo cognitivo proactivo e inspector ambiental con radar de reposo (dwell).",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
