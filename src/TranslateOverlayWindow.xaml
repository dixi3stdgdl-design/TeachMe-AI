<Window x:Class="ToolTipAI.TranslateOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolTip AI — Pure Ambient Text Lens"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="100"
        MaxWidth="520"
        MinHeight="24"
        MaxHeight="360"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">
    
    <!-- SIN PANEL: Solo el texto puro con su ligera transición de fondo y velo de luz -->
    <Grid Margin="6 4 6 4" ClipToBounds="False">
        <!-- Ligera transición y halo de fondo con contraste óptico equilibrado (legible sobre blanco y oscuro) -->
        <Border x:Name="TextBackdropGlow"
                CornerRadius="8"
                BorderBrush="#2538BDF8"
                BorderThickness="0.6"
                Padding="10 5 10 5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0003060E" Offset="0.0"/>
                    <GradientStop Color="#8503060E" Offset="0.08"/>
                    <GradientStop Color="#9003060E" Offset="0.5"/>
                    <GradientStop Color="#8503060E" Offset="0.92"/>
                    <GradientStop Color="#0003060E" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.6" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Contenedor del texto traducido con revelado progresivo sincronizado -->
                <Grid x:Name="TextContainerGrid">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="TextRevealClip" Rect="0,0,520,360"/>
                    </Grid.Clip>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Texto Principal Traducido: Tipografía nítida con sombra de contorno sin cortar palabras -->
                    <TextBlock x:Name="TranslatedTextDisplay"
                               Grid.Row="0"
                               Text="Traducción contextual instantánea"
                               Foreground="#FFFFFF"
                               FontWeight="Bold"
                               FontSize="13.5"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0 0 0 2">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" Color="#000000" Opacity="1.0" ShadowDepth="1.5" Direction="315"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Snippet de texto original sutil en plata/cyan -->
                    <TextBlock x:Name="OriginalTextDisplay"
                               Grid.Row="1"
                               Text="「Escaneando texto...」"
                               Foreground="#93C5FD"
                               FontWeight="Medium"
                               FontSize="9.5"
                               TextWrapping="Wrap"
                               Margin="0 0 0 1">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3" Color="#000000" Opacity="0.95" ShadowDepth="1" Direction="315"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <!-- Velo y haz sutil de luz que barre horizontalmente revelando el texto traducido -->
                <Canvas x:Name="LaserRevealCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid x:Name="LaserRevealCarriage" Canvas.Left="-25" Canvas.Top="0" Width="24" Height="160">
                        <!-- Aura suave translúcida de luz -->
                        <Rectangle Width="20" Height="160" HorizontalAlignment="Center" Opacity="0.25">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0000F5A0" Offset="0"/>
                                    <GradientStop Color="#3038BDF8" Offset="0.5"/>
                                    <GradientStop Color="#0000F5A0" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Hilo fino de luz pura -->
                        <Rectangle Width="1.2" Height="160" HorizontalAlignment="Center">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0038BDF8" Offset="0"/>
                                    <GradientStop Color="#E0FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#0038BDF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#38BDF8" Opacity="0.6" ShadowDepth="0"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </Canvas>
            </Grid>
        </Border>

        <!-- Elementos ocultos mantenidos para compatibilidad de código C# -->
        <Border x:Name="MainHudBorder" Visibility="Collapsed" IsHitTestVisible="False"/>
        <TextBlock x:Name="SourceLangPill" Visibility="Collapsed"/>
        <TextBlock x:Name="PhoneticDisplay" Visibility="Collapsed"/>
        <TextBlock x:Name="BadgeText" Visibility="Collapsed"/>
        <TextBlock x:Name="TokenText" Visibility="Collapsed"/>
        <Border x:Name="TokenBorder" Visibility="Collapsed"/>
        <Button x:Name="BtnSpeak" Visibility="Collapsed"/>
        <Button x:Name="BtnCopy" Visibility="Collapsed"/>
        <TextBlock x:Name="CopyIcon" Visibility="Collapsed"/>
        <TextBlock x:Name="CopyBtnLabel" Visibility="Collapsed"/>
        <Button x:Name="BtnPin" Visibility="Collapsed"/>
        <Button x:Name="BtnClose" Visibility="Collapsed"/>
    </Grid>
</Window>
