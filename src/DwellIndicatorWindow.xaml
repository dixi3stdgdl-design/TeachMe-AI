<Window x:Class="ToolTipAI.DwellIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolTip AI — Dwell Heartbeat Aura"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="80"
        MaxWidth="260"
        IsHitTestVisible="False"
        Opacity="0.0">

    <Window.Resources>
        <!-- Pulso de latido del radar de reposo — mismo ritmo que TranslateOverlay -->
        <Storyboard x:Key="DwellHeartbeat" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DwellBeamPath"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.7" To="1.4" Duration="0:0:0.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DwellBeamPath"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.75" Duration="0:0:0.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Fade-in de ventana -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Fade-out de ventana -->
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Sin panel rígido: solo gradiente translúcido + texto flotante puro -->
    <Grid Margin="6 3 6 3">
        <!-- Halo de fondo con mismo patrón que TranslateOverlay -->
        <Border x:Name="DwellBackdrop"
                CornerRadius="8"
                BorderBrush="#2000F5A0"
                BorderThickness="0.6"
                Padding="10 5 10 6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00030A0A" Offset="0.0"/>
                    <GradientStop Color="#82030A0A" Offset="0.08"/>
                    <GradientStop Color="#90030A0A" Offset="0.5"/>
                    <GradientStop Color="#82030A0A" Offset="0.92"/>
                    <GradientStop Color="#00030A0A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.55" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Heartbeat beam del radar — color verde esmeralda Aura -->
                <Path x:Name="DwellBeamPath"
                      Grid.Row="0"
                      Data="M 0,5 L 30,5 C 35,5 37,3 39,1 C 41,0 43,9 46,9 C 49,9 51,5 56,5 L 120,5"
                      StrokeThickness="1.0"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5"
                      Opacity="0.45"
                      Margin="0 0 0 4">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000F5A0" Offset="0.0"/>
                            <GradientStop Color="#6000F5A0" Offset="0.3"/>
                            <GradientStop Color="#FF00F5A0" Offset="0.5"/>
                            <GradientStop Color="#6000F5A0" Offset="0.7"/>
                            <GradientStop Color="#0000F5A0" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="7" Color="#2DD4BF" Opacity="0.55" ShadowDepth="0"/>
                    </Path.Effect>
                </Path>

                <!-- Texto de estado flotante — misma tipografía que TranslateOverlay -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="StatusText"
                               Text="Analizando..."
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="11"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" Color="#000000" Opacity="1.0" ShadowDepth="1" Direction="315"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="TimeText"
                               Text=" 3.0s"
                               Foreground="#2DD4BF"
                               FontSize="11"
                               FontWeight="Medium"
                               Margin="4 0 0 0"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3" Color="#000000" Opacity="0.9" ShadowDepth="1" Direction="315"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
