<Window x:Class="TeachMeAI.CursorBeamOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolTip AI — Heartbeat Pulse Aura"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        Width="220"
        Height="22"
        Opacity="0.0">
    
    <Window.Resources>
        <!-- Animación de latido orgánico sutil (ritmo cardíaco de luz) -->
        <Storyboard x:Key="HeartbeatAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HeartbeatWave"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.85" To="1.3" Duration="0:0:0.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeartbeatWave"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.8" Duration="0:0:0.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Contenedor 100% libre de cajas o bordes rígidos: translúcido sobre la pantalla -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="20">
        <!-- Haz de luz orgánico en forma de latido (Cardiograma sutil) -->
        <Path x:Name="HeartbeatWave"
              Data="M 0,10 L 65,10 C 72,10 74,8 77,4 C 80,0 82,18 86,18 C 90,18 92,10 98,10 L 200,10"
              StrokeThickness="1.2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              RenderTransformOrigin="0.5,0.5"
              Opacity="0.55">
            <Path.RenderTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Path.RenderTransform>
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0038BDF8" Offset="0.0"/>
                    <GradientStop Color="#5038BDF8" Offset="0.25"/>
                    <GradientStop Color="#F0FBBF24" Offset="0.5"/>
                    <GradientStop Color="#5038BDF8" Offset="0.75"/>
                    <GradientStop Color="#0038BDF8" Offset="1.0"/>
                </LinearGradientBrush>
            </Path.Stroke>
            <Path.Effect>
                <DropShadowEffect x:Name="HeartbeatGlow" BlurRadius="8" Color="#38BDF8" Opacity="0.5" ShadowDepth="0"/>
            </Path.Effect>
        </Path>

        <!-- Pulso de progreso de 3s (un hilo de luz dorada que viaja por el latido) -->
        <Path x:Name="ProgressGlowPath"
              Data="M 0,10 L 65,10 C 72,10 74,8 77,4 C 80,0 82,18 86,18 C 90,18 92,10 98,10 L 200,10"
              StrokeThickness="1.8"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Opacity="0.0">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FBBF24" Offset="0.0"/>
                    <GradientStop Color="#FFFBBF24" Offset="0.5"/>
                    <GradientStop Color="#00FBBF24" Offset="1.0"/>
                </LinearGradientBrush>
            </Path.Stroke>
            <Path.Effect>
                <DropShadowEffect BlurRadius="12" Color="#FBBF24" Opacity="0.8" ShadowDepth="0"/>
            </Path.Effect>
        </Path>
    </Grid>
</Window>
