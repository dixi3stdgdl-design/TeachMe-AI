<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       TOOLTIP AI · PREMIUM DESIGN TOKENS
       Mismo lenguaje que tooltip-ai.com (cyber-glass + light ribbons)
       ============================================================ -->

  <!-- Void / surfaces -->
  <SolidColorBrush x:Key="Void.Brush" Color="#FF04060A"/>
  <SolidColorBrush x:Key="Surface.0" Color="#FF0A0F18"/>
  <SolidColorBrush x:Key="Surface.1" Color="#FF121826"/>
  <SolidColorBrush x:Key="Surface.2" Color="#FF1A2232"/>
  <SolidColorBrush x:Key="Stroke.Hairline" Color="#22FFFFFF"/>
  <SolidColorBrush x:Key="Stroke.Accent" Color="#402DD4BF"/>

  <!-- Ink -->
  <SolidColorBrush x:Key="Ink.1" Color="#FFF7FAFC"/>
  <SolidColorBrush x:Key="Ink.2" Color="#FFC2CEDC"/>
  <SolidColorBrush x:Key="Ink.3" Color="#FF8A97A8"/>

  <!-- Brand -->
  <Color x:Key="Brand.Teal">#FF2DD4BF</Color>
  <Color x:Key="Brand.Sky">#FF38BDF8</Color>
  <Color x:Key="Brand.Violet">#FFA78BFA</Color>
  <Color x:Key="Brand.Amber">#FFFBBF24</Color>
  <Color x:Key="Brand.Rose">#FFF43F5E</Color>

  <SolidColorBrush x:Key="Brand.Teal.Brush" Color="#FF2DD4BF"/>
  <SolidColorBrush x:Key="Brand.Sky.Brush" Color="#FF38BDF8"/>
  <SolidColorBrush x:Key="Brand.Violet.Brush" Color="#FFA78BFA"/>

  <!-- Light ribbon / accent gradients (el "brillo" del render) -->
  <LinearGradientBrush x:Key="Brand.Ribbon" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF2DD4BF" Offset="0"/>
    <GradientStop Color="#FF38BDF8" Offset="0.55"/>
    <GradientStop Color="#FFA78BFA" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brand.Ribbon.Horizontal" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF2DD4BF" Offset="0"/>
    <GradientStop Color="#FF38BDF8" Offset="1"/>
  </LinearGradientBrush>

  <!-- Glass panel: fondo profundo + borde de luz -->
  <LinearGradientBrush x:Key="Glass.Panel" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F0121826" Offset="0"/>
    <GradientStop Color="#F00A0F18" Offset="0.55"/>
    <GradientStop Color="#E6070B12" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Glass.Edge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#662DD4BF" Offset="0"/>
    <GradientStop Color="#22FFFFFF" Offset="0.45"/>
    <GradientStop Color="#5538BDF8" Offset="1"/>
  </LinearGradientBrush>

  <!-- Botón primario (shine de la web) -->
  <LinearGradientBrush x:Key="Button.Primary" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF2DD4BF" Offset="0"/>
    <GradientStop Color="#FF14B8A6" Offset="0.45"/>
    <GradientStop Color="#FF38BDF8" Offset="1"/>
  </LinearGradientBrush>

  <!-- Glow suave para acentos -->
  <SolidColorBrush x:Key="Glow.Teal" Color="#662DD4BF"/>
  <SolidColorBrush x:Key="Glow.Sky" Color="#6638BDF8"/>
  <SolidColorBrush x:Key="Glow.Violet" Color="#66A78BFA"/>

  <!-- Radios -->
  <CornerRadius x:Key="Radius.Panel">18</CornerRadius>
  <CornerRadius x:Key="Radius.Card">12</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">6</CornerRadius>

  <!-- Tipografía de producto -->
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

  <Style x:Key="Text.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink.1}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink.2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource Ink.3}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Chip / badge -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="#22FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke.Hairline}"/>
    <Setter Property="BorderThickness" Value="0.8"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
    <Setter Property="Padding" Value="8,3"/>
  </Style>

  <!-- Botón ghost premium -->
  <Style x:Key="Button.Ghost" TargetType="Button">
    <Setter Property="Background" Value="#18FFFFFF"/>
    <Setter Property="Foreground" Value="{StaticResource Ink.1}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke.Hairline}"/>
    <Setter Property="BorderThickness" Value="0.8"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#28FFFFFF"/>
              <Setter TargetName="B" Property="BorderBrush" Value="#662DD4BF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Background" Value="#12FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón primario con shine -->
  <Style x:Key="Button.Primary" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Button.Primary}"/>
    <Setter Property="Foreground" Value="#FF042F2A"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="B"
                    Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#FF2DD4BF" BlurRadius="18" Opacity="0.35" ShadowDepth="0"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#FF2DD4BF" BlurRadius="28" Opacity="0.55" ShadowDepth="0"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Opacity" Value="0.92"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
