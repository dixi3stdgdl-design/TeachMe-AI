<Window x:Class="TeachMeAI.SnippingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolTip AI — Ambient Capture Lens"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#18000008"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        Opacity="0.0"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">

    <Window.Resources>
        <!-- Fade-in de la capa de captura -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Latido del banner de instrucción — mismo patrón que CursorBeamOverlay -->
        <Storyboard x:Key="BannerHeartbeat" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BannerBeamPath"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.6" To="1.5" Duration="0:0:0.55" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BannerBeamPath"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.65" Duration="0:0:0.55" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Trigger: fade-in al cargar -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Canvas de selección: capa de dibujo libre sin contenedores -->
        <Canvas x:Name="OverlayCanvas">

            <!-- Área seleccionada: borde de haz neón + fill etéreo -->
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF38BDF8" Offset="0.0"/>
                        <GradientStop Color="#FF00F5A0" Offset="0.5"/>
                        <GradientStop Color="#FF818CF8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Stroke>
                <Rectangle.StrokeThickness>1.5</Rectangle.StrokeThickness>
                <Rectangle.StrokeDashArray>
                    <x:Array Type="sys:Double" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                        <sys:Double>5</sys:Double>
                        <sys:Double>3</sys:Double>
                    </x:Array>
                </Rectangle.StrokeDashArray>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A38BDF8" Offset="0.0"/>
                        <GradientStop Color="#0A00F5A0" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#38BDF8" Opacity="0.5" ShadowDepth="0"/>
                </Rectangle.Effect>
            </Rectangle>

            <!-- Tag de dimensiones — mismo estilo que TranslateOverlay: gradiente translúcido -->
            <Border x:Name="DimensionTag"
                    Visibility="Collapsed"
                    CornerRadius="6"
                    BorderBrush="#2038BDF8"
                    BorderThickness="0.6"
                    Padding="8 3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00030610" Offset="0.0"/>
                        <GradientStop Color="#8A030610" Offset="0.15"/>
                        <GradientStop Color="#9A030610" Offset="0.5"/>
                        <GradientStop Color="#8A030610" Offset="0.85"/>
                        <GradientStop Color="#00030610" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.5" ShadowDepth="1" Direction="270"/>
                </Border.Effect>
                <TextBlock x:Name="DimensionText"
                           Foreground="#38BDF8"
                           FontFamily="JetBrains Mono, Consolas"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Text="0 × 0 px">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="3" Color="#000000" Opacity="0.9" ShadowDepth="1" Direction="315"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>
        </Canvas>

        <!-- Banner de instrucción: puro texto flotante con heartbeat beam (sin borde rígido) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 28 0 0">
            <Border x:Name="InstructionBackdrop"
                    CornerRadius="10"
                    BorderBrush="#1838BDF8"
                    BorderThickness="0.6"
                    Padding="18 9 18 10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00030610" Offset="0.0"/>
                        <GradientStop Color="#88030610" Offset="0.12"/>
                        <GradientStop Color="#9A030610" Offset="0.5"/>
                        <GradientStop Color="#88030610" Offset="0.88"/>
                        <GradientStop Color="#00030610" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Color="#000000" Opacity="0.6" ShadowDepth="3" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Heartbeat beam del banner — cyan/sky igual que CursorBeamOverlay -->
                    <Path x:Name="BannerBeamPath"
                          Grid.Row="0"
                          Data="M 0,5 L 55,5 C 62,5 64,3 67,1 C 70,0 73,9 77,9 C 81,9 84,5 91,5 L 200,5"
                          StrokeThickness="1.0"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5"
                          Opacity="0.4"
                          Margin="0 0 0 6">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0038BDF8" Offset="0.0"/>
                                <GradientStop Color="#6038BDF8" Offset="0.3"/>
                                <GradientStop Color="#E0FFFFFF"  Offset="0.5"/>
                                <GradientStop Color="#6038BDF8" Offset="0.7"/>
                                <GradientStop Color="#0038BDF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="6" Color="#38BDF8" Opacity="0.5" ShadowDepth="0"/>
                        </Path.Effect>
                    </Path>

                    <!-- Texto de instrucción flotante -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚡"
                                   Foreground="#2DD4BF"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0 0 9 0"/>
                        <TextBlock Text="Arrastra para capturar el área"
                                   Foreground="#F1F5F9"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" Color="#000000" Opacity="1.0" ShadowDepth="1.5" Direction="315"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="  •  "
                                   Foreground="#334155"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <!-- Tecla Esc: chip sutil -->
                        <Border Background="#1AFFFFFF"
                                BorderBrush="#2538BDF8"
                                BorderThickness="0.8"
                                CornerRadius="4"
                                Padding="5 1"
                                VerticalAlignment="Center">
                            <TextBlock Text="Esc"
                                       Foreground="#38BDF8"
                                       FontSize="10.5"
                                       FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text=" cancelar"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="4 0 0 0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
